<script>
    document.addEventListener("DOMContentLoaded", function () {
        let cartDisplay = document.getElementById("cartDisplay");
        let cartTotal = document.getElementById("cartTotal");
        let cartSummarySection = document.getElementById("cartSummarySection");
        let emptyCartMessage = document.getElementById("emptyCartMessage");
        let cartItemCount = document.getElementById("cartItemCount");
        let checkoutLink = document.getElementById("checkoutLink");

        let cartItems = JSON.parse(localStorage.getItem("cartItems")) || [];
                          
        loadCartFromDatabase();
        updateCartCount();
        updateCartTotal();

         checkoutLink.addEventListener("click", function () {
             let cartItems = JSON.parse(localStorage.getItem("cartItems")) || [];
              localStorage.setItem("checkoutItems", JSON.stringify(cartItems));
              saveCartToDatabase();
        });
    });  
    
    async function loadCartFromDatabase() {
          try {
              let response = await fetch("/Home/Cart");

              // Check if response is actually JSON
              let text = await response.text();  // Get raw response text
              //console.log("Raw API Response:", text); // Debugging

              let data;
              try {
                  data = JSON.parse(text); // Try parsing JSON
              } catch (jsonError) {
                  //console.error("Invalid JSON response from API:", text);
                  return; // Stop execution if JSON is invalid
              }

              if (data.success && data.cartItems.length > 0) {
                  cartItems = data.cartItems;
                   localStorage.setItem("cartItems", JSON.stringify(cartItems)); //  Ensure LocalStorage updates
              } else {
                  console.log("No items in the cart.");
              }
          } catch (error) {
              console.error("Error loading cart from database:", error);
          }
      }

    async function saveCartToDatabase() {
            try {
                let cartItems = JSON.parse(localStorage.getItem("cartItems")) || [];

                if (cartItems.length === 0) {
                    await deleteCartItem();
                    return;
                }

                cartItems = cartItems.map(item => ({
                    shoppingCartId: item.shoppingCartId || 0,
                    iShopId: item.iShopId || 0,
                    arrivingDays: item.arrivingDays || 0,
                    color: item.color || "",
                    description: item.description || "",
                    image: item.image || "",
                    name: item.name || "",
                    price: parseFloat(item.price) || 0,
                    productId: parseInt(item.productId) || 0,
                    productsImageId: parseInt(item.productsImageId) || parseInt(item.productImageId), //  Ensure it's a number
                    quantity: parseInt(item.quantity) || 1, //  Ensure it's an integer
                    total: parseFloat(item.total) || 0,
                    type: item.type || ""
                }));

                console.log(" Sending Cart Data to Backend:", cartItems);

                let response = await fetch("/Home/SaveCart", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(cartItems),
                });

                if (response.ok) {
                    console.log(" Cart saved successfully.");
                    localStorage.setItem("cartItems", JSON.stringify(cartItems)); //  Ensure LocalStorage updates
                    updateCartCount();                     
                } else {
                    console.error(" Failed to save cart.");
                }
            } catch (error) {
                console.error(" Error saving cart:", error);
            }
        }

     //Function to Check Stock Availability
    async function checkStockAvailability(productImageId, requestedQty) {
         try {
             let response = await fetch(`/Home/CheckStockAvailability?productImageId=${productImageId}&requestedQty=${requestedQty}`);
             let data = await response.json();
             return response.ok && data.success; //  Return true if stock is available
         } catch (error) {
             console.error(" Error checking stock:", error);
             return false; //  If error occurs, assume stock is not available
         }
     }

    function updateCartTotal() {
          let cartTotal = 0;

          document.querySelectorAll(".total-price").forEach(totalElement => {
              let totalValue = parseFloat(totalElement.textContent.replace("₹", "").trim());
              if (!isNaN(totalValue)) {
                  cartTotal += totalValue; //  Add each item's total to cart total
              }
          });

          let cartTotalElement = document.getElementById("cartTotal");
          if (cartTotalElement) {
              cartTotalElement.textContent = cartTotal.toFixed(2); //  Update subtotal
          }

          //  Show or hide cart summary section
          let cartSummarySection = document.getElementById("cartSummarySection");
          if (cartSummarySection) {
              cartSummarySection.style.display = cartTotal > 0 ? "block" : "none";
          }
     }

