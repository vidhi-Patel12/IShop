    document.addEventListener("click", async function (event) {
        if (event.target.classList.contains("btn-increase") || event.target.classList.contains("btn-decrease")) {
            let cartItem = event.target.closest(".tf-cart-item");
            if (!cartItem) {
                console.log("cartItem is missing!");
                return;
            }

            let quantityInput = cartItem.querySelector(".quantity-product");
            let priceElement = cartItem.querySelector(".new-price");
            let totalElement = cartItem.querySelector(".total-price");

            let productsImageId = parseInt(cartItem.getAttribute("data-product-image-id"), 10);
            let productId = parseInt(cartItem.getAttribute("data-productid"), 10);
            let image = cartItem.querySelector("img")?.src || "";
            let name = cartItem.querySelector(".cart-title")?.textContent.trim() || "";
            let color = cartItem.querySelector("#pColor")?.textContent.trim() || "";
            let description = cartItem.getAttribute("data-description") || "";
            let arrivingDays = cartItem.getAttribute("data-arriving-days") || "";
            let type = cartItem.getAttribute("data-type") || "";

            if (!quantityInput || !priceElement || !totalElement || isNaN(productsImageId) || isNaN(productId)) {
                console.log("Missing elements inside cartItem!");
                return;
            }

            let quantity = parseInt(quantityInput.value);
            let price = parseFloat(priceElement.textContent.replace("₹", "").trim());

            if (isNaN(price)) {
                console.log("unitPrice is NaN! Check if the price element has a valid number.");
                return;
            }

            event.target.disabled = true;
            setTimeout(() => { event.target.disabled = false; }, 500);

            if (event.target.classList.contains("btn-increase")) {
                let isAvailable = await checkStockAvailability(productsImageId, quantity + 1);
                if (!isAvailable) {
                    // alert("Stock limit reached! Cannot increase quantity.");
                    showMessageModal("success", "Stock limit reached! Cannot increase quantity.");
                    return;
                }
                quantity + 1;
            } else if (event.target.classList.contains("btn-decrease") && quantity > 1) {
                quantity - 1;
            }

            quantityInput.value = quantity;
            let newTotal = parseFloat((quantity * price).toFixed(2));
            totalElement.textContent = `₹${newTotal.toFixed(2)}`;

            // Fetch all cart data
            let cartData = [];
            document.querySelectorAll("#cartDisplay .tf-cart-item").forEach(item => {
                let itemData = {
                    productId: parseInt(item.getAttribute("data-productid"), 10),
                    productsImageId: parseInt(item.getAttribute("data-product-image-id"), 10),
                    quantity: parseInt(item.querySelector(".quantity-product").value),
                    price: parseFloat(item.querySelector(".new-price").textContent.replace("₹", "").trim()),
                    total: parseFloat(item.querySelector(".total-price").textContent.replace("₹", "").trim()),
                    image: item.querySelector("img")?.src || "",
                    name: item.querySelector(".cart-title")?.textContent.trim() || "",
                    color: item.querySelector("#pColor")?.textContent.trim() || "",
                    description: item.getAttribute("data-description") || "",
                    arrivingDays: item.getAttribute("data-arriving-days") || "",
                    type: item.getAttribute("data-type") || ""
                };

                cartData.push(itemData);
            });

            console.log(" Updated Cart Data:", cartData);

            localStorage.setItem("cartItems", JSON.stringify(cartData));

            await saveCartToDatabase();
            updateCartTotal();
            updateCartCount();
        }
    });


    document.addEventListener("click", async function (event) {
        if (event.target.classList.contains("remove")) {
            let cartItem = event.target.closest(".tf-cart-item");
            if (!cartItem) {
                console.log("Cart item not found!");
                return;
            }
            
            let productsImageId = parseInt(cartItem.getAttribute("data-product-image-id"), 10);
            // let productId = parseInt(cartItem.getAttribute("data-productid"), 10);
            // alert("productid : ",productId);

            if (isNaN(productsImageId)) {
                console.log("Invalid product IDs!");
                return;
            }

            try {
                await deleteCartItem(productsImageId);
                console.log(`Item ${productsImageId} deleted from database successfully.`);
                 // Remove item from DOM
            cartItem.remove();

            // Update cart data in local storage
            saveCartToDatabase();
            loadCartFromDatabase();
            } catch (error) {
                console.error("Error deleting item from database:", error);
            }
        }
    });

    async function deleteCartItem(productsImageId) {
        if (!productsImageId) {
            console.error("Invalid product or image ID:", productsImageId);
            return;
        }

        try {
            let response = await fetch("/Home/DeleteCartItem", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ProductsImageId: productsImageId }),
            });

            let result = await response.json();

            if (result.success) {
                console.log("Item deleted successfully from the cart.");
            } else {
                console.log("Failed to delete item from the cart.");
            }

            updateCartTotal();
            updateCartCount();
        } catch (error) {
            console.error("Error deleting item from cart:", error);
        }
    }

    function updateCartCount() {
        let cartItems = JSON.parse(localStorage.getItem("cartItems")) || [];

        // Create a new map to store cart items with all details
        let updatedCart = new Map();

        document.querySelectorAll(".tf-cart-item").forEach(cartItem => {
            let productsImageId = cartItem.getAttribute("data-product-image-id");
            let productId = cartItem.getAttribute("data-productid");
            let quantityInput = cartItem.querySelector(".quantity-product");

            if (productsImageId && quantityInput) {
                let newQuantity = parseInt(quantityInput.value, 10);
                let price = parseFloat(cartItem.querySelector(".new-price").textContent.replace("₹", "").trim());
                let total = parseFloat((newQuantity * price).toFixed(2));
                let image = cartItem.querySelector("img")?.src || "";
                let name = cartItem.querySelector(".cart-title")?.textContent.trim() || "";
                let color = cartItem.querySelector("#pColor")?.textContent.trim() || "";
                let description = cartItem.getAttribute("data-description") || "";
                let arrivingDays = cartItem.getAttribute("data-arriving-days") || "";
                let type = cartItem.getAttribute("data-type") || "";

                // Store complete item details in the map
                updatedCart.set(productsImageId, {
                    productsImageId,
                    productId,
                    quantity: newQuantity,
                    price,
                    total,
                    image,
                    name,
                    color,
                    description,
                    arrivingDays,
                    type
                });
            }
        });

        // Convert map to an array
        let updatedCartArray = Array.from(updatedCart.values());

        let oldCartString = JSON.stringify(cartItems);
        let newCartString = JSON.stringify(updatedCartArray);

        // Only update `localStorage` if there are changes
        if (oldCartString !== newCartString) {
            localStorage.setItem("cartItems", newCartString);
        }

        // Calculate total quantity
        let totalItems = updatedCartArray.reduce((total, item) => total + item.quantity, 0);

        // Update UI
        let cartItemCount = document.getElementById("cartItemCount");
        if (cartItemCount) {
            cartItemCount.innerText = totalItems;
        }
    }

    function showMessageModal(type, message) {
         let modalTitle = document.getElementById("messageModalLabel");
         let modalBody = document.getElementById("messageText");
         let modalHeader = document.querySelector("#messageModal .modal-header");

         // Update the modal based on type (success or error)
         if (type === "success") {
             modalTitle.innerText = "Success";
             modalBody.innerHTML = `✅ ${message}`;
             modalHeader.classList.add("bg-success", "text-white");
             modalHeader.classList.remove("bg-danger");
         } else if (type === "error") {
             modalTitle.innerText = "Error";
             modalBody.innerHTML = `❌ ${message}`;
             modalHeader.classList.add("bg-danger", "text-white");
             modalHeader.classList.remove("bg-success");
         }

         // Show the modal
         let messageModal = new bootstrap.Modal(document.getElementById("messageModal"));
         messageModal.show();
    }

</script>



